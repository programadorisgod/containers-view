# Containers View — variables de entorno
# Copia este archivo a `.env` y ajusta los valores.

# Destinatario y remitente por defecto de las notificaciones.
# También pueden editarse desde la interfaz (Ajustes -> Notificaciones).
NOTIFY_TO=alguien@ejemplo.com
NOTIFY_FROM=containers@ejemplo.com

# Canal Email (SMTP). Si no se configuran, el canal email aparece como
# "sin configurar" en la interfaz y no se usa.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Canal Telegram. Requiere crear un bot con BotFather y conocer el chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ruta alternativa donde guardar el estado persistente (watch state y ajustes).
# Por defecto usa ./data dentro del directorio del proyecto.
# CONTAINERS_VIEW_DATA=
